{
  "manifest_version": 3,
  "name": "Habits",
  "version": "1.0.0",
  "description": "Habits — трекеры, задачи, чек-листы, дневник и остальное вне Telegram.",
  "browser_specific_settings": {
    "gecko": {
      "id": "habits@resager.ru",
      "strict_min_version": "115.0",
      "update_url": "{{APP_URL}}ext/updates.json"
    }
  },
  "action": {
    "default_title": "Habits",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
